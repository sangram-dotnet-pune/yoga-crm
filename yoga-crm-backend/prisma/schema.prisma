generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CLINICIAN
  ADMIN
}

enum PatientStatus {
  ACTIVE
  COMPLETED
  FOLLOW_UP
}

enum ApptStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PayMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  OTHER
}

enum ExpenseCategory {
  EQUIPMENT
  SUPPLIES
  RENT
  UTILITIES
  MARKETING
  STAFF
  MAINTENANCE
  OTHER
}

enum XrayKind {
  LEGACY_BEFORE
  LEGACY_AFTER
  RECORD
}

model Clinic {
  id         String   @id @default(cuid())
  name       String
  doctorName String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users    User[]
  patients Patient[]
  expenses Expense[]
  media    MediaAsset[]
  imports  ImportBatch[]

  @@index([createdAt])
}

model User {
  id           String   @id @default(cuid())
  clinicId     String
  clinic       Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(CLINICIAN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]

  @@index([clinicId])
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Patient {
  id             String        @id @default(cuid())
  clinicId       String
  clinic         Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientCode    String
  name           String
  age            Int
  gender         String
  phone          String
  visitDate      DateTime      @db.Date
  condition      String
  painBefore     Int
  painAfter      Int?
  mobilityBefore String        @default("Not recorded")
  mobilityAfter  String?
  notes          String        @default("")
  diagnosis      String        @default("")
  doctor         String        @default("")
  planMonths     Int           @default(3)
  followUpDate   DateTime      @db.Date
  status         PatientStatus @default(ACTIVE)
  fee            Decimal       @default(0) @db.Decimal(12, 2)
  paid           Decimal       @default(0) @db.Decimal(12, 2)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  visits       Visit[]
  payments     Payment[]
  xrays        XrayImage[]
  exercises    Exercise[]
  planLogs     PlanLog[]
  appointments Appointment[]
  expenses     Expense[]

  @@unique([clinicId, patientCode])
  @@index([clinicId])
  @@index([clinicId, status])
}

model Visit {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  visitType String
  painScore Int?
  mobility  Int?
  treatment String?
  exercises String?
  notes     String?
  createdAt DateTime @default(now())

  @@index([patientId, date])
}

model Payment {
  id            String    @id @default(cuid())
  patientId     String
  patient       Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  amount        Decimal   @db.Decimal(12, 2)
  date          DateTime  @db.Date
  paymentMethod PayMethod
  reference     String?
  notes         String?
  createdAt     DateTime  @default(now())

  @@index([patientId, date])
}

model XrayImage {
  id        String    @id @default(cuid())
  patientId String
  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  kind      XrayKind  @default(RECORD)
  date      DateTime  @db.Date
  bodyArea  String?
  title     String?
  notes     String?
  mediaId   String    @unique
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([patientId, date])
}

model MediaAsset {
  id         String   @id @default(cuid())
  clinicId   String
  clinic     Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  storageKey String   @unique
  bucket     String
  mimeType   String
  sizeBytes  Int
  width      Int?
  height     Int?
  createdAt  DateTime @default(now())

  xray XrayImage?

  @@index([clinicId])
}

model Exercise {
  id        String  @id @default(cuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name      String
  frequency String  @default("")
  duration  String  @default("")
  notes     String  @default("")
  sortOrder Int     @default(0)

  @@index([patientId, sortOrder])
}

model PlanLog {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  months    Int

  @@index([patientId, date])
}

model Appointment {
  id        String     @id @default(cuid())
  patientId String
  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  date      DateTime   @db.Date
  startTime String
  endTime   String
  type      String
  status    ApptStatus @default(SCHEDULED)
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([patientId, date])
  @@index([date, status])
}

model Expense {
  id            String          @id @default(cuid())
  clinicId      String
  clinic        Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  date          DateTime        @db.Date
  category      ExpenseCategory
  description   String
  amount        Decimal         @db.Decimal(12, 2)
  paymentMethod PayMethod
  patientId     String?
  patient       Patient?        @relation(fields: [patientId], references: [id], onDelete: SetNull)
  notes         String?
  createdAt     DateTime        @default(now())

  @@index([clinicId, date])
}

model ImportBatch {
  id         String   @id @default(cuid())
  clinicId   String
  clinic     Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  sourceHash String
  importedAt DateTime @default(now())
  summary    Json

  @@unique([clinicId, sourceHash])
  @@index([clinicId])
}
